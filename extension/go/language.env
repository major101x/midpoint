# Language manifest — presence of this file is what marks a directory as an
# extension implementation. Scripts glob */language.env to discover languages,
# so a directory that merely happens to contain a Dockerfile (like proxy/) is
# never mistaken for one.
#
# Sourced by scripts/lib/language.sh. Keep it to simple KEY=value assignments.
# All commands run with this directory as the working directory.

# Human-readable name, used in log output.
LANGUAGE_NAME="Go"

# Dockerfile path, relative to this directory.
LANGUAGE_DOCKERFILE="Dockerfile"

# Install dependencies. Empty when the toolchain handles it implicitly.
LANGUAGE_SETUP_CMD=""

# Compile. Empty when the run command compiles on the fly.
LANGUAGE_BUILD_CMD=""

# Run the unit test suite.
LANGUAGE_TEST_CMD="go test ./..."

# Start the extension HTTP server in the foreground, reading EXTENSION_PORT and
# SIGN_PORT from the environment. Used by scripts/test-conformance.sh, which
# exercises the extension alone — no tee-node, no proxy, no chain.
LANGUAGE_RUN_CMD="go run ./cmd"
