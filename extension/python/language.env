# Language manifest — see scripts/lib/language.sh and go/language.env for the
# full field documentation. All commands run with this directory as the cwd.

LANGUAGE_NAME="Python"
LANGUAGE_DOCKERFILE="Dockerfile"

# A venv keeps the toolchain self-contained and avoids PEP 668 friction with
# system python. .venv is gitignored.
LANGUAGE_SETUP_CMD="python3 -m venv .venv && ./.venv/bin/pip install -q -r requirements-dev.txt"
LANGUAGE_BUILD_CMD=""
LANGUAGE_TEST_CMD="./.venv/bin/python -m pytest -q"
LANGUAGE_RUN_CMD="./.venv/bin/python main.py"
