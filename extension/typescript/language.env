# Language manifest — see scripts/lib/language.sh and go/language.env for the
# full field documentation. All commands run with this directory as the cwd.

LANGUAGE_NAME="TypeScript"
LANGUAGE_DOCKERFILE="Dockerfile"

LANGUAGE_SETUP_CMD="npm ci --silent"
LANGUAGE_BUILD_CMD="npm run build"
LANGUAGE_TEST_CMD="npm test"
LANGUAGE_RUN_CMD="node dist/main.js"
